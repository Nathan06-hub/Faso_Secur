# Reverse-Proxy Souverain HTTPS / TLS 1.3 & WSS pour FASO-SÉCUR (DGTD / MTDPCE)
# Force TLS (HTTPS + WebSocket sécurisé WSS) pour garantir le contexte sécurisé W3C WebCrypto sur réseau LAN/WAN.

{$FASO_SECUR_DOMAIN:localhost}, :8443 {
    tls internal

    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), geolocation=(), payment=()"
    }

    @backend_routes {
        path /api/* /ws* /docs* /openapi.json
    }

    handle @backend_routes {
        reverse_proxy faso-secur-backend:8000
    }

    handle {
        reverse_proxy faso-secur-frontend:5173
    }
}
