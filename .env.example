# Configuration Souveraine FASO-SÉCUR (Variables d'environnement & Docker Secrets)
# En production étatique (Datacenter DGTD), injecter ces secrets via Vault / Docker Secrets (/run/secrets/... ou *_FILE).

DATABASE_URL=sqlite:///./data/faso_secur_sovereign.db
# Emplacement du coffre de secrets persistant (strictement séparé du répertoire de la base SQLite)
FASO_SECUR_SECRETS_FILE=/app/secrets/.faso_secur_server_secrets.json

# Option A : Injection par fichiers secrets (Docker Secrets / HashiCorp Vault Agent) — Recommandé en production
# FASO_SECUR_JWT_SECRET_FILE=/run/secrets/faso_secur_jwt_secret
# FASO_SECUR_METADATA_PEPPER_FILE=/run/secrets/faso_secur_metadata_pepper
# FASO_SECUR_TOTP_FERNET_KEY_FILE=/run/secrets/faso_secur_totp_fernet_key

# Option B : laisser ces valeurs vides pour générer des secrets CSPRNG persistés
# dans FASO_SECUR_SECRETS_FILE. En production, privilégier Vault ou Docker Secrets.
FASO_SECUR_JWT_SECRET=
FASO_SECUR_METADATA_PEPPER=
FASO_SECUR_TOTP_FERNET_KEY=

# Mode démo désactivé par défaut en production (mettre true uniquement pour les épreuves de démonstration du jury)
FASO_SECUR_DEMO_MODE=false
FASO_SECUR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,https://msg.gouv.bf
FASO_SECUR_DOMAIN=localhost
