# Configuration Souveraine FASO-SÉCUR (Variables d'environnement)
# En production étatique (Datacenter DGTD), injecter ces secrets via Vault / Docker Secrets.

DATABASE_URL=sqlite:///./data/faso_secur_sovereign.db
FASO_SECUR_JWT_SECRET=remplacer_par_secret_csprng_256_bits_en_production
FASO_SECUR_METADATA_PEPPER=remplacer_par_poivre_hmac_souverain_en_production
FASO_SECUR_DEMO_MODE=true
FASO_SECUR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://msg.gouv.bf
